<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - AlMasterclass</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #000; color: #fff; }

        .header { background: rgba(0,0,0,0.95); border-bottom: 1px solid rgba(255,255,255,0.1); padding: 20px 40px; position: sticky; top: 0; z-index: 100; }
        .header-content { max-width: 1440px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
        .logo { font-size: 24px; font-weight: 900; color: #fff; text-decoration: none; display: flex; align-items: center; gap: 10px; }
        .logo-mark { width: 36px; height: 36px; background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 18px; }
        .nav { display: flex; gap: 24px; align-items: center; }
        .nav a { color: #999; text-decoration: none; font-size: 14px; font-weight: 500; transition: color 0.3s; }
        .nav a:hover { color: #fff; }
        .btn-logout { background: #1a1a1a; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 600; }
        .btn-logout:hover { background: #2a2a2a; }

        .container { max-width: 1440px; margin: 0 auto; padding: 40px; }
        .welcome { margin-bottom: 40px; }
        .welcome h1 { font-size: 40px; font-weight: 900; margin-bottom: 8px; }
        .badge { display: inline-block; padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 700; margin-top: 8px; }
        .badge-free { background: #1a1a1a; color: #999; }
        .badge-premium { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; }

        .affiliate-box { background: linear-gradient(135deg, #667eea, #764ba2); padding: 40px; border-radius: 20px; margin-bottom: 40px; }
        .affiliate-box h2 { font-size: 28px; font-weight: 900; margin-bottom: 12px; }
        .affiliate-link-group { display: flex; gap: 12px; margin-top: 20px; }
        .affiliate-link { flex: 1; padding: 16px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); border-radius: 12px; color: #fff; font-size: 14px; }
        .btn-copy { padding: 16px 32px; background: #fff; color: #000; border: none; border-radius: 12px; font-weight: 700; cursor: pointer; }
        .btn-copy:hover { background: #f0f0f0; }

        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 40px; }
        .stat-card { background: #0a0a0a; border: 1px solid #1a1a1a; padding: 32px; border-radius: 16px; }
        .stat-card h3 { font-size: 14px; color: #999; margin-bottom: 12px; font-weight: 600; }
        .stat-value { font-size: 36px; font-weight: 900; background: linear-gradient(135deg, #667eea, #764ba2); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

        .card { background: #0a0a0a; border: 1px solid #1a1a1a; padding: 32px; border-radius: 16px; }
        .card h3 { font-size: 20px; font-weight: 800; margin-bottom: 16px; }
        .card ol { margin-left: 20px; line-height: 2; color: #999; }

        @media (max-width: 768px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .container { padding: 20px; }
            .affiliate-link-group { flex-direction: column; }
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="header-content">
            <a href="/" class="logo"><div class="logo-mark">A</div>AlMasterclass</a>
            <nav class="nav">
                <a href="/dashboard">Dashboard</a>
                <a href="/affiliate">Affiliate</a>
                <form action="/api/auth/logout" method="POST" style="display:inline;">
                    <button type="submit" class="btn-logout">Sign Out</button>
                </form>
            </nav>
        </div>
    </header>

    <div class="container">
        <div class="welcome">
            <h1>Welcome back, <%= user.full_name %>!</h1>
            <span class="badge <%= user.subscription_status === 'active' ? 'badge-premium' : 'badge-free' %>">
                <%= user.subscription_status === 'active' ? 'Premium Member' : 'Free Account' %>
            </span>
        </div>

        <div class="affiliate-box">
            <h2>Your Affiliate Link</h2>
            <p>Share this link and earn 30% recurring commissions FOR LIFE!</p>
            <div class="affiliate-link-group">
                <input type="text" class="affiliate-link" id="affLink" value="<%= affiliateLink %>" readonly>
                <button class="btn-copy" onclick="copyLink()">Copy Link</button>
            </div>
            <p style="margin-top:16px; font-size:14px; opacity:0.9;">Your code: <strong><%= user.affiliate_code %></strong></p>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <h3>Total Referrals</h3>
                <div class="stat-value"><%= affiliateStats.total_referrals || 0 %></div>
            </div>
            <div class="stat-card">
                <h3>Active Subscribers</h3>
                <div class="stat-value"><%= affiliateStats.active_referrals || 0 %></div>
            </div>
            <div class="stat-card">
                <h3>Total Earned</h3>
                <div class="stat-value">$<%= (affiliateStats.total_commissions_earned || 0).toFixed(2) %></div>
            </div>
            <div class="stat-card">
                <h3>Pending Payout</h3>
                <div class="stat-value">$<%= (affiliateStats.pending_commissions || 0).toFixed(2) %></div>
            </div>
        </div>

        <div class="card">
            <h3>How It Works</h3>
            <ol>
                <li>Share your unique affiliate link</li>
                <li>When they sign up (free), they're tied to you forever</li>
                <li>If they upgrade to premium (even months later), you earn 30%</li>
                <li>You keep earning every month as long as they stay subscribed</li>
                <li>Minimum payout: $50 (automatic)</li>
            </ol>
        </div>
    </div>

    <script>
        function copyLink() {
            const link = document.getElementById('affLink');
            link.select();
            document.execCommand('copy');
            event.target.textContent = 'Copied!';
            setTimeout(() => event.target.textContent = 'Copy Link', 2000);
        }
    </script>
</body>
</html>
