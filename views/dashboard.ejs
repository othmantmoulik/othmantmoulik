<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - AlMasterclass</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .nav {
            background: rgba(255, 255, 255, 0.95);
            padding: 15px 30px;
            margin-bottom: 30px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .nav-brand {
            font-size: 1.5em;
            font-weight: bold;
            color: #764ba2;
        }

        .nav-links {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .nav-link {
            color: #333;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 5px;
            transition: background 0.3s;
        }

        .nav-link:hover {
            background: #f0f0f0;
        }

        .btn {
            padding: 8px 16px;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            font-size: 1em;
        }

        .btn-logout {
            background: #dc3545;
            color: white;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .welcome {
            background: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .welcome h1 {
            color: #764ba2;
            margin-bottom: 10px;
        }

        .badge {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9em;
            font-weight: bold;
        }

        .badge-free {
            background: #6c757d;
            color: white;
        }

        .badge-premium {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .card h3 {
            color: #764ba2;
            margin-bottom: 15px;
            font-size: 1.1em;
        }

        .stat-number {
            font-size: 2.5em;
            font-weight: bold;
            color: #764ba2;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #666;
            font-size: 0.9em;
        }

        .affiliate-box {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
        }

        .affiliate-box h2 {
            margin-bottom: 15px;
        }

        .affiliate-link-container {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .affiliate-link {
            flex: 1;
            padding: 12px;
            border-radius: 8px;
            border: 2px solid white;
            background: rgba(255, 255, 255, 0.2);
            color: white;
            font-size: 1em;
        }

        .btn-copy {
            padding: 12px 24px;
            background: white;
            color: #764ba2;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
        }

        .btn-copy:hover {
            background: #f0f0f0;
        }

        .btn-upgrade {
            display: inline-block;
            padding: 15px 30px;
            background: white;
            color: #764ba2;
            text-decoration: none;
            border-radius: 50px;
            font-weight: bold;
            margin-top: 15px;
        }

        .btn-upgrade:hover {
            background: #f0f0f0;
        }
    </style>
</head>
<body>
    <div class="container">
        <nav class="nav">
            <div class="nav-brand">AlMasterclass</div>
            <div class="nav-links">
                <a href="/dashboard" class="nav-link">Dashboard</a>
                <a href="/courses" class="nav-link">Courses</a>
                <a href="/community" class="nav-link">Community</a>
                <a href="/affiliate" class="nav-link">Affiliate</a>
                <form action="/api/auth/logout" method="POST" style="display: inline;">
                    <button type="submit" class="btn btn-logout">Logout</button>
                </form>
            </div>
        </nav>

        <div class="welcome">
            <h1>Welcome back, <%= user.full_name %>! 👋</h1>
            <p>
                <span class="badge <%= user.subscription_status === 'active' ? 'badge-premium' : 'badge-free' %>">
                    <%= user.subscription_status === 'active' ? 'Premium Member' : 'Free Account' %>
                </span>
            </p>
        </div>

        <% if (user.subscription_status !== 'active') { %>
        <div class="affiliate-box">
            <h2>Unlock Premium Content</h2>
            <p>Get access to all courses, community features, and start earning 30% recurring commissions!</p>
            <a href="/upgrade" class="btn-upgrade">Upgrade to Premium →</a>
        </div>
        <% } %>

        <div class="affiliate-box">
            <h2>📢 Your Affiliate Link</h2>
            <p>Share this link and earn 30% recurring commissions FOR LIFE when your referrals upgrade!</p>
            <div class="affiliate-link-container">
                <input type="text" class="affiliate-link" id="affiliateLink" value="<%= affiliateLink %>" readonly>
                <button class="btn-copy" onclick="copyLink()">Copy Link</button>
            </div>
            <p style="margin-top: 15px; font-size: 0.9em; opacity: 0.9;">
                Your unique code: <strong><%= user.affiliate_code %></strong>
            </p>
        </div>

        <h2 style="color: white; margin-bottom: 20px;">Your Affiliate Performance</h2>

        <div class="grid">
            <div class="card">
                <h3>Total Referrals</h3>
                <div class="stat-number"><%= affiliateStats.total_referrals || 0 %></div>
                <div class="stat-label">People you've referred</div>
            </div>

            <div class="card">
                <h3>Active Subscribers</h3>
                <div class="stat-number"><%= affiliateStats.active_referrals || 0 %></div>
                <div class="stat-label">Paying members</div>
            </div>

            <div class="card">
                <h3>Total Earned</h3>
                <div class="stat-number">$<%= (affiliateStats.total_commissions_earned || 0).toFixed(2) %></div>
                <div class="stat-label">All-time commissions</div>
            </div>

            <div class="card">
                <h3>Pending Payout</h3>
                <div class="stat-number">$<%= (affiliateStats.pending_commissions || 0).toFixed(2) %></div>
                <div class="stat-label">Ready to withdraw</div>
            </div>
        </div>

        <div class="card">
            <h3>How It Works</h3>
            <ol style="line-height: 2; color: #666;">
                <li>Share your unique affiliate link with friends and family</li>
                <li>When they sign up (free), they're tied to you forever via their email</li>
                <li>If they upgrade to premium (even months later), you earn 30% commission</li>
                <li>You keep earning 30% every month as long as they stay subscribed</li>
                <li>Minimum payout: $50 (automatic when reached)</li>
            </ol>
        </div>
    </div>

    <script>
        function copyLink() {
            const linkInput = document.getElementById('affiliateLink');
            linkInput.select();
            linkInput.setSelectionRange(0, 99999);
            document.execCommand('copy');

            const btn = event.target;
            const originalText = btn.textContent;
            btn.textContent = 'Copied!';
            setTimeout(() => {
                btn.textContent = originalText;
            }, 2000);
        }
    </script>
</body>
</html>
