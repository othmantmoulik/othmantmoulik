<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Affiliate Dashboard - AlMasterclass</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #000; color: #fff; }

        .header { background: rgba(0,0,0,0.95); border-bottom: 1px solid rgba(255,255,255,0.1); padding: 20px 40px; position: sticky; top: 0; z-index: 100; }
        .header-content { max-width: 1440px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
        .logo { font-size: 24px; font-weight: 900; color: #fff; text-decoration: none; display: flex; align-items: center; gap: 10px; }
        .logo-mark { width: 36px; height: 36px; background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 18px; }
        .nav { display: flex; gap: 24px; align-items: center; }
        .nav a { color: #999; text-decoration: none; font-size: 14px; font-weight: 500; transition: color 0.3s; }
        .nav a:hover { color: #fff; }
        .btn-logout { background: #1a1a1a; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 600; }

        .container { max-width: 1440px; margin: 0 auto; padding: 40px; }
        .page-header { margin-bottom: 40px; }
        .page-header h1 { font-size: 40px; font-weight: 900; margin-bottom: 8px; }
        .page-header p { color: #999; font-size: 16px; }

        .stats-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; margin-bottom: 40px; }
        .stat-card { background: #0a0a0a; border: 1px solid #1a1a1a; padding: 28px; border-radius: 14px; text-align: center; }
        .stat-card h3 { font-size: 12px; color: #999; margin-bottom: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
        .stat-value { font-size: 32px; font-weight: 900; background: linear-gradient(135deg, #667eea, #764ba2); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

        .card { background: #0a0a0a; border: 1px solid #1a1a1a; padding: 32px; border-radius: 16px; margin-bottom: 32px; }
        .card h2 { font-size: 20px; font-weight: 800; margin-bottom: 24px; }

        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 12px; font-size: 12px; color: #999; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1px solid #1a1a1a; }
        td { padding: 16px 12px; border-bottom: 1px solid #1a1a1a; font-size: 14px; }

        .badge { display: inline-block; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 700; }
        .badge-free { background: #1a1a1a; color: #999; }
        .badge-upgraded { background: rgba(34, 197, 94, 0.2); color: #4ade80; }

        .empty-state { text-align: center; padding: 60px 20px; color: #666; }
        .empty-state-icon { font-size: 64px; margin-bottom: 16px; }

        @media (max-width: 1024px) {
            .stats-grid { grid-template-columns: repeat(3, 1fr); }
        }
        @media (max-width: 768px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .container { padding: 20px; }
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="header-content">
            <a href="/" class="logo"><div class="logo-mark">A</div>AlMasterclass</a>
            <nav class="nav">
                <a href="/dashboard">Dashboard</a>
                <a href="/affiliate">Affiliate</a>
                <form action="/api/auth/logout" method="POST" style="display:inline;">
                    <button type="submit" class="btn-logout">Sign Out</button>
                </form>
            </nav>
        </div>
    </header>

    <div class="container">
        <div class="page-header">
            <h1>💰 Affiliate Dashboard</h1>
            <p>Track your referrals and earnings in real-time</p>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <h3>Total Referrals</h3>
                <div class="stat-value"><%= affiliateStats.total_referrals || 0 %></div>
            </div>
            <div class="stat-card">
                <h3>Active</h3>
                <div class="stat-value"><%= affiliateStats.active_referrals || 0 %></div>
            </div>
            <div class="stat-card">
                <h3>Total Earned</h3>
                <div class="stat-value">$<%= (affiliateStats.total_commissions_earned || 0).toFixed(0) %></div>
            </div>
            <div class="stat-card">
                <h3>Pending</h3>
                <div class="stat-value">$<%= (affiliateStats.pending_commissions || 0).toFixed(0) %></div>
            </div>
            <div class="stat-card">
                <h3>Paid Out</h3>
                <div class="stat-value">$<%= (affiliateStats.paid_commissions || 0).toFixed(0) %></div>
            </div>
        </div>

        <div class="card">
            <h2>Your Referrals</h2>
            <% if (referrals && referrals.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Joined</th>
                        <th>Status</th>
                        <th>Upgraded</th>
                    </tr>
                </thead>
                <tbody>
                    <% referrals.forEach(ref => { %>
                    <tr>
                        <td><%= ref.full_name %></td>
                        <td style="color:#999;"><%= ref.email %></td>
                        <td><%= new Date(ref.signup_date).toLocaleDateString() %></td>
                        <td>
                            <span class="badge <%= ref.status === 'upgraded' ? 'badge-upgraded' : 'badge-free' %>">
                                <%= ref.status === 'upgraded' ? 'Premium' : 'Free' %>
                            </span>
                        </td>
                        <td><%= ref.upgraded_at ? new Date(ref.upgraded_at).toLocaleDateString() : '-' %></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <div class="empty-state">
                <div class="empty-state-icon">🎯</div>
                <h3 style="color:#fff;margin-bottom:8px;">No referrals yet</h3>
                <p>Share your affiliate link to start earning commissions!</p>
            </div>
            <% } %>
        </div>

        <div class="card">
            <h2>Commission Structure</h2>
            <p style="color:#999;line-height:1.8;">
                You earn <strong style="color:#fff;">30% recurring commission</strong> on all payments from your referrals.<br><br>
                <strong style="color:#fff;">Monthly Plan ($47/month):</strong> You earn $14.10/month per referral<br>
                <strong style="color:#fff;">Yearly Plan ($470/year):</strong> You earn $141/year per referral<br><br>
                Commissions are paid automatically when you reach $50 minimum payout.
            </p>
        </div>
    </div>
</body>
</html>
