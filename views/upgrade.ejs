<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upgrade to Premium - AlMasterclass</title>
    <script src="https://js.stripe.com/v3/"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .nav {
            background: rgba(255, 255, 255, 0.95);
            padding: 15px 30px;
            margin-bottom: 30px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .nav-brand {
            font-size: 1.5em;
            font-weight: bold;
            color: #764ba2;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .header {
            text-align: center;
            color: white;
            margin-bottom: 40px;
        }

        .header h1 {
            font-size: 3em;
            margin-bottom: 15px;
        }

        .header p {
            font-size: 1.3em;
            opacity: 0.95;
        }

        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-bottom: 40px;
        }

        .pricing-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            transition: transform 0.3s;
            position: relative;
        }

        .pricing-card:hover {
            transform: translateY(-10px);
        }

        .popular-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: bold;
        }

        .plan-name {
            font-size: 1.5em;
            color: #764ba2;
            margin-bottom: 10px;
        }

        .plan-price {
            font-size: 3em;
            font-weight: bold;
            color: #333;
            margin-bottom: 5px;
        }

        .plan-period {
            color: #666;
            margin-bottom: 20px;
        }

        .plan-savings {
            background: #28a745;
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            display: inline-block;
            font-size: 0.9em;
            margin-bottom: 20px;
        }

        .features {
            list-style: none;
            margin: 30px 0;
        }

        .features li {
            padding: 10px 0;
            color: #666;
            border-bottom: 1px solid #eee;
        }

        .features li:before {
            content: "✓ ";
            color: #28a745;
            font-weight: bold;
            margin-right: 10px;
        }

        .btn-subscribe {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
            border-radius: 50px;
            font-size: 1.1em;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .btn-subscribe:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(118, 75, 162, 0.3);
        }

        .btn-subscribe:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .benefits {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }

        .benefits h2 {
            color: #764ba2;
            margin-bottom: 30px;
            text-align: center;
        }

        .benefits-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
        }

        .benefit-item {
            text-align: center;
        }

        .benefit-icon {
            font-size: 3em;
            margin-bottom: 15px;
        }

        .benefit-item h3 {
            color: #333;
            margin-bottom: 10px;
        }

        .benefit-item p {
            color: #666;
        }

        .guarantee {
            text-align: center;
            margin-top: 30px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 10px;
        }

        .guarantee strong {
            color: #764ba2;
        }
    </style>
</head>
<body>
    <div class="container">
        <nav class="nav">
            <div class="nav-brand">AlMasterclass</div>
            <a href="/dashboard" style="color: #333; text-decoration: none;">← Back to Dashboard</a>
        </nav>

        <div class="header">
            <h1>Upgrade to Premium</h1>
            <p>Unlock everything + Start earning 30% commissions</p>
        </div>

        <div class="pricing-grid">
            <div class="pricing-card">
                <div class="plan-name">Monthly</div>
                <div class="plan-price">$47</div>
                <div class="plan-period">per month</div>

                <ul class="features">
                    <li>All premium courses</li>
                    <li>Community access</li>
                    <li>30% recurring commissions</li>
                    <li>Live Q&A sessions</li>
                    <li>Lifetime updates</li>
                </ul>

                <button class="btn-subscribe" onclick="subscribe('monthly')">
                    Get Started Monthly
                </button>
            </div>

            <div class="pricing-card">
                <div class="popular-badge">Best Value 🔥</div>
                <div class="plan-name">Yearly</div>
                <div class="plan-price">$470</div>
                <div class="plan-period">per year</div>
                <div class="plan-savings">Save $94 (2 months free!)</div>

                <ul class="features">
                    <li>All premium courses</li>
                    <li>Community access</li>
                    <li>30% recurring commissions</li>
                    <li>Live Q&A sessions</li>
                    <li>Lifetime updates</li>
                    <li>Priority support</li>
                    <li>Exclusive yearly bonuses</li>
                </ul>

                <button class="btn-subscribe" onclick="subscribe('yearly')">
                    Get Started Yearly
                </button>
            </div>
        </div>

        <div class="benefits">
            <h2>What You Get As a Premium Member</h2>

            <div class="benefits-grid">
                <div class="benefit-item">
                    <div class="benefit-icon">🎓</div>
                    <h3>Complete Course Library</h3>
                    <p>Access all current and future courses worth $5,000+</p>
                </div>

                <div class="benefit-item">
                    <div class="benefit-icon">💰</div>
                    <h3>Affiliate Commissions</h3>
                    <p>Earn 30% recurring on every referral, for life</p>
                </div>

                <div class="benefit-item">
                    <div class="benefit-icon">🤝</div>
                    <h3>Private Community</h3>
                    <p>Network with 2,000+ Muslim entrepreneurs</p>
                </div>

                <div class="benefit-item">
                    <div class="benefit-icon">🎯</div>
                    <h3>Live Coaching</h3>
                    <p>Monthly group coaching calls with Othman</p>
                </div>

                <div class="benefit-item">
                    <div class="benefit-icon">📚</div>
                    <h3>Resource Library</h3>
                    <p>Templates, scripts, and frameworks to implement fast</p>
                </div>

                <div class="benefit-item">
                    <div class="benefit-icon">🔄</div>
                    <h3>Lifetime Updates</h3>
                    <p>All new content added to the platform, free</p>
                </div>
            </div>

            <div class="guarantee">
                <strong>30-Day Money-Back Guarantee:</strong> If you're not satisfied, we'll refund you 100%. No questions asked.
            </div>
        </div>
    </div>

    <script>
        const stripe = Stripe('<%= process.env.STRIPE_PUBLISHABLE_KEY || "pk_test_your_key" %>');

        async function subscribe(plan) {
            const priceId = plan === 'monthly'
                ? '<%= monthlyPriceId || "" %>'
                : '<%= yearlyPriceId || "" %>';

            if (!priceId) {
                alert('Stripe is not configured yet. Please add your Stripe keys to .env file.');
                return;
            }

            const buttons = document.querySelectorAll('.btn-subscribe');
            buttons.forEach(btn => {
                btn.disabled = true;
                btn.textContent = 'Loading...';
            });

            try {
                const response = await fetch('/api/stripe/create-checkout', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ priceId })
                });

                const { sessionId } = await response.json();

                const result = await stripe.redirectToCheckout({ sessionId });

                if (result.error) {
                    alert(result.error.message);
                    buttons.forEach(btn => {
                        btn.disabled = false;
                        btn.textContent = btn.dataset.originalText;
                    });
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred. Please try again.');
                buttons.forEach(btn => {
                    btn.disabled = false;
                    btn.textContent = btn.dataset.originalText || 'Get Started';
                });
            }
        }
    </script>
</body>
</html>
