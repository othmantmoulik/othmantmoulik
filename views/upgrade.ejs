<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upgrade to Premium - AlMasterclass</title>
    <script src="https://js.stripe.com/v3/"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #000; color: #fff; padding: 40px 20px; }

        .container { max-width: 1200px; margin: 0 auto; }
        .header { text-align: center; margin-bottom: 60px; }
        .header h1 { font-size: 56px; font-weight: 900; margin-bottom: 16px; letter-spacing: -2px; }
        .header p { font-size: 20px; color: #999; }

        .pricing-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px; max-width: 900px; margin: 0 auto 60px; }
        .pricing-card { background: #0a0a0a; border: 1px solid #1a1a1a; border-radius: 20px; padding: 48px; transition: all 0.3s; }
        .pricing-card:hover { border-color: #333; transform: translateY(-4px); }
        .pricing-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; color: #999; text-transform: uppercase; letter-spacing: 1px; }
        .price { font-size: 64px; font-weight: 900; margin-bottom: 8px; letter-spacing: -2px; }
        .period { color: #666; margin-bottom: 24px; }
        .savings { background: rgba(34, 197, 94, 0.15); color: #4ade80; padding: 8px 16px; border-radius: 20px; display: inline-block; font-size: 13px; font-weight: 700; margin-bottom: 24px; }

        ul { list-style: none; margin-bottom: 32px; }
        li { padding: 12px 0; color: #999; border-bottom: 1px solid #1a1a1a; }
        li:before { content: "✓"; color: #4ade80; font-weight: 900; margin-right: 12px; }

        .btn { width: 100%; padding: 18px; background: #fff; color: #000; border: none; border-radius: 12px; font-size: 16px; font-weight: 700; cursor: pointer; transition: all 0.3s; }
        .btn:hover { background: #f0f0f0; transform: translateY(-2px); }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; }

        @media (max-width: 768px) {
            .pricing-grid { grid-template-columns: 1fr; }
            .header h1 { font-size: 36px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Upgrade to <span style="background:linear-gradient(135deg,#667eea,#764ba2);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Premium</span></h1>
            <p>Unlock everything + Start earning 30% commissions</p>
        </div>

        <div class="pricing-grid">
            <div class="pricing-card">
                <h3>Monthly</h3>
                <div class="price">$47</div>
                <div class="period">per month</div>
                <ul>
                    <li>All premium courses</li>
                    <li>Community access</li>
                    <li>30% recurring commissions</li>
                    <li>Live Q&A sessions</li>
                    <li>Lifetime updates</li>
                </ul>
                <button class="btn" onclick="subscribe('monthly')">Get Started Monthly</button>
            </div>

            <div class="pricing-card" style="border-color:#667eea;">
                <h3>Yearly <span style="color:#667eea;">• Best Value</span></h3>
                <div class="price">$470</div>
                <div class="period">per year</div>
                <div class="savings">Save $94 (2 months free!)</div>
                <ul>
                    <li>All premium courses</li>
                    <li>Community access</li>
                    <li>30% recurring commissions</li>
                    <li>Live Q&A sessions</li>
                    <li>Lifetime updates</li>
                    <li>Priority support</li>
                    <li>Exclusive bonuses</li>
                </ul>
                <button class="btn" onclick="subscribe('yearly')">Get Started Yearly</button>
            </div>
        </div>

        <div style="text-align:center;color:#666;max-width:600px;margin:0 auto;">
            <strong style="color:#fff;">30-Day Money-Back Guarantee:</strong> If you're not satisfied, we'll refund you 100%. No questions asked.
        </div>
    </div>

    <script>
        const stripe = Stripe('<%= process.env.STRIPE_PUBLISHABLE_KEY || "pk_test_demo" %>');

        async function subscribe(plan) {
            const priceId = plan === 'monthly' ? '<%= monthlyPriceId || "" %>' : '<%= yearlyPriceId || "" %>';

            if (!priceId || priceId === 'price_demo_monthly' || priceId === 'price_demo_yearly') {
                alert('Stripe is not configured yet. Please add your Stripe keys to environment variables.');
                return;
            }

            const buttons = document.querySelectorAll('.btn');
            buttons.forEach(btn => {
                btn.disabled = true;
                btn.textContent = 'Loading...';
            });

            try {
                const response = await fetch('/api/stripe/create-checkout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ priceId })
                });

                const { sessionId } = await response.json();
                const result = await stripe.redirectToCheckout({ sessionId });

                if (result.error) {
                    alert(result.error.message);
                    buttons.forEach(btn => {
                        btn.disabled = false;
                        btn.textContent = 'Get Started';
                    });
                }
            } catch (error) {
                alert('Error creating checkout session');
                buttons.forEach(btn => {
                    btn.disabled = false;
                    btn.textContent = 'Get Started';
                });
            }
        }
    </script>
</body>
</html>
